PORT=8787
# Your public HTTPS URL, used for same-origin checks and Secure cookies.
# On Render this defaults to the injected RENDER_EXTERNAL_URL; set it only for a custom domain.
PUBLIC_ORIGIN=http://localhost:8787
# Set to 1 when running behind a reverse proxy (Render, Fly, nginx) so rate limits use X-Forwarded-For.
TRUST_PROXY=0
# Keep on a persistent volume. Run exactly one app instance per SQLite database.
VIBESCORE_DATA_DIR=.local/data

# AI coach (optional). Use a standard API key, not a coding-tool subscription.
# Providers: gemini (default, has a free tier), openai (any OpenAI-compatible
# endpoint with bearer auth, set AI_ENDPOINT), foundry/azure (Azure AI Foundry,
# set its full v1 chat-completions endpoint), zai.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
# openai/azure only: full HTTPS chat/completions URL.
AI_ENDPOINT=
AI_DAILY_REQUEST_LIMIT=200
AI_USER_DAILY_REQUEST_LIMIT=20
AI_MAX_OUTPUT_TOKENS=1200

# Optional GoDaddy Agent Name Service explorer and hosted-agent registration.
# Credentials stay server-side and use GoDaddy's sso-key authorization.
ANS_BASE_URL=https://api.godaddy.com
ANS_API_KEY=
ANS_API_SECRET=

# Optional governed resource catalog and clinic-event destination.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=vibescore
DATABRICKS_SCHEMA=hokie
DATABRICKS_RESOURCES_TABLE=campus_resources
DATABRICKS_CLINIC_EVENTS_TABLE=clinic_event_v1

# Optional no-account clinic evaluation. Use at least 32 random characters.
CLINIC_PSEUDONYM_SECRET=

# Litestream backup (production, used by the Docker image). Leave blank locally.
# Any S3-compatible bucket works; docs/DEPLOY.md describes the Azure Blob alternative.
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Azure Container Apps alternative to the S3 settings above. Set both values;
# Litestream authenticates through the app's managed identity (no storage key).
LITESTREAM_AZURE_ACCOUNT_NAME=
LITESTREAM_AZURE_CONTAINER=
