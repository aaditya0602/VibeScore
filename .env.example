PORT=8787
# Required in production: your public HTTPS URL. Used for same-origin protection.
PUBLIC_ORIGIN=http://localhost:8787
# Keep on a persistent local volume. Run one app instance per SQLite database.
VIBESCORE_DATA_DIR=.local/data
# Set only behind a trusted reverse proxy that supplies X-Forwarded-For (Azure App Service does).
TRUST_PROXY=0
# Leave AI unconfigured until you have a standard API key (not a coding subscription).
# Supported: zai, gemini, azure. Never put keys in frontend files.
AI_PROVIDER=zai
AI_API_KEY=
AI_MODEL=
# Azure only: full HTTPS chat/completions URL for your deployed model.
AI_ENDPOINT=
AI_DAILY_REQUEST_LIMIT=200
AI_USER_DAILY_REQUEST_LIMIT=20
AI_MAX_OUTPUT_TOKENS=1200
# Optional GoDaddy Agent Name Service explorer. Credentials stay server-side.
ANS_BASE_URL=https://api.godaddy.com
# GoDaddy developer key pair; sent as server-side sso-key authorization.
ANS_API_KEY=
ANS_API_SECRET=
# Optional governed campus-resource catalog for the Hokie Career Navigator.
# Use a least-privilege service principal or PAT with SELECT on this table only.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=vibescore
DATABRICKS_SCHEMA=hokie
DATABRICKS_RESOURCES_TABLE=campus_resources
# Optional clinic outbox destination. Grant INSERT/MERGE only on this table.
DATABRICKS_CLINIC_EVENTS_TABLE=clinic_event_v1
# Optional no-account clinic evaluation. Generate at least 32 random characters.
# Used only to derive rotating pseudonyms; never expose it to the browser.
CLINIC_PSEUDONYM_SECRET=
