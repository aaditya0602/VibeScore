PORT=8787
# Required in production: your public HTTPS URL. Used for same-origin protection.
PUBLIC_ORIGIN=http://localhost:8787
# Keep on a persistent local volume. Run one app instance per SQLite database.
VIBESCORE_DATA_DIR=.local/data
# Leave AI unconfigured until you have a standard API key (not a coding subscription).
# Supported: zai, gemini, azure. Never put keys in frontend files.
AI_PROVIDER=zai
AI_API_KEY=
AI_MODEL=
# Azure only: full HTTPS chat/completions URL for your deployed model.
AI_ENDPOINT=
AI_DAILY_REQUEST_LIMIT=200
AI_USER_DAILY_REQUEST_LIMIT=20
AI_MAX_OUTPUT_TOKENS=1200
# Optional GoDaddy Agent Name Service explorer. Credentials stay server-side.
ANS_BASE_URL=https://api.ote-godaddy.com
ANS_API_TOKEN=
